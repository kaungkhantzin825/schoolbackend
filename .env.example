APP_NAME=Laravel
APP_ENV=local          # production: APP_ENV=production
APP_KEY=
APP_DEBUG=true         # production: APP_DEBUG=false  (true leaks stack traces + credentials)
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=university_verification
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD="your-16-char-app-password"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-address@gmail.com"
# Display name recipients see. Keep it "ACVR" — leaving it unset is why mail
# shows up as coming from "Laravel".
MAIL_FROM_NAME="ACVR"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ── ACVR branding / contact ──
# Support mailbox that receives contact-form messages. This is the *recipient*,
# not the sender: the SMTP account above must stay as MAIL_FROM_ADDRESS, because
# Gmail refuses to send as an address it does not own.
ACVR_NAME="ACVR"
ACVR_LONG_NAME="Academic Credential Verification & Registry"
ACVR_SUPPORT_EMAIL="support@acvr.edu.mm"
ACVR_WEBSITE="https://acvr.edu.mm"

# Set to "*" (or your proxy IPs) when the API sits behind Cloudflare or a load
# balancer; otherwise the activity log records the proxy IP and location.
TRUSTED_PROXIES=
